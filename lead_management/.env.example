# === MEOS:BASE Lead Management — Umgebungsvariablen ===
# Kopiere diese Datei als .env und fülle die Werte aus.

# --- App ---
MEOS_APP_PORT=8100
MEOS_DEBUG=false
MEOS_WEBHOOK_SECRET=dein-geheimes-webhook-secret-hier

# --- Telegram (für Lead-Benachrichtigungen) ---
MEOS_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
MEOS_TELEGRAM_CHAT_ID=-100123456789

# --- WhatsApp Business API ---
MEOS_WHATSAPP_TOKEN=EAABx...
MEOS_WHATSAPP_PHONE_ID=123456789
MEOS_WHATSAPP_VERIFY_TOKEN=dein-verify-token

# --- Facebook Messenger ---
MEOS_MESSENGER_PAGE_TOKEN=EAABx...
MEOS_MESSENGER_VERIFY_TOKEN=dein-verify-token

# --- Email (SMTP für Auto-Reply) ---
MEOS_SMTP_HOST=smtp.strato.de
MEOS_SMTP_PORT=587
MEOS_SMTP_USER=info@schreinerhelden.de
MEOS_SMTP_PASSWORD=dein-email-passwort
MEOS_SMTP_FROM=info@schreinerhelden.de

# --- Freund CRM ---
MEOS_FREUND_CRM_URL=https://api.freund-crm.de
MEOS_FREUND_CRM_API_KEY=dein-freund-crm-api-key

# --- Buchungsseite (für Neukunden) ---
MEOS_BOOKING_URL=https://calendly.com/schreinerhelden/beratung

# --- n8n ---
MEOS_N8N_BASE_URL=https://n8n.dein-vps.de
